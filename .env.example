# =========================================
# APP CONFIGURATION
# =========================================
APP_NAME=IdentityForge
APP_VERSION=1.0.0
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# =========================================
# DATABASE (PostgreSQL via Docker)
# Local development connects via localhost:5432.
# When running full stack in Docker, docker-compose automatically
# routes DATABASE_URL to db:5432 without needing edits.
# =========================================
DATABASE_URL="postgres://root:rootpassword@localhost:5432/identityforge?schema=public"

# =========================================
# AUTHENTICATION (JWT)
# =========================================
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
JWT_VERIFICATION_SECRET=your_super_secret_verification_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
JWT_VERIFICATION_EXPIRES_IN=900

# =========================================
# SECURITY & RATE LIMITING
# =========================================
BCRYPT_SALT_ROUNDS=10
MAX_FAILED_LOGIN=5
ACCOUNT_LOCK_DURATION=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# =========================================
# REDIS (Caching, Queues, Rate Limiting)
# Local development connects via localhost:6379.
# Docker compose automatically routes REDIS_HOST to 'redis'.
# =========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================================
# EMAIL (SMTP)
# =========================================
SMTP_NAME="IdentityForge Mailer"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASS=password